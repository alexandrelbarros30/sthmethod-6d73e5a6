<svg width="512" height="512" viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="512" height="512" rx="128" fill="black"/>
  <!-- Master V1: Grid Layout (Musculação, Nutrição, Exames, IA) -->
  
  <!-- Musculação (Halter - Top Left) -->
  <path d="M100 160L160 100M120 180L180 120" stroke="#CCFF00" stroke-width="24" stroke-linecap="round"/>
  <circle cx="100" cy="160" r="30" stroke="#CCFF00" stroke-width="20"/>
  <circle cx="180" cy="120" r="30" stroke="#CCFF00" stroke-width="20"/>
  
  <!-- Nutrição (Maçã - Top Right) -->
  <path d="M380 120C340 120 320 140 320 180C320 220 340 260 380 260C420 260 440 220 440 180C440 140 420 120 380 120Z" fill="#10B981"/>
  <path d="M380 120C380 100 390 90 400 80" stroke="#10B981" stroke-width="12" stroke-linecap="round"/>
  
  <!-- Exames (Pulso/Activity - Bottom Left) -->
  <path d="M80 380H120L140 320L180 440L200 380H240" stroke="#3B82F6" stroke-width="24" stroke-linecap="round" stroke-linejoin="round"/>
  
  <!-- IA/Network (Bottom Right) -->
  <circle cx="360" cy="360" r="15" fill="white"/>
  <circle cx="430" cy="360" r="15" fill="white"/>
  <circle cx="395" cy="425" r="15" fill="white"/>
  <path d="M360 360L395 425L430 360" stroke="white" stroke-width="6" stroke-dasharray="8 8"/>
  <circle cx="395" cy="360" r="5" fill="#CCFF00" opacity="0.8">
    <animate attributeName="opacity" values="0.8;0.2;0.8" dur="2s" repeatCount="indefinite" />
  </circle>
</svg>
